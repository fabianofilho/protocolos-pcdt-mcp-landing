---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Disclaimer from "../components/Disclaimer.astro";
import Problema from "../components/Problema.astro";
import ComoFunciona from "../components/ComoFunciona.astro";
import Tools from "../components/Tools.astro";
import ComoRodar from "../components/ComoRodar.astro";
import Footer from "../components/Footer.astro";

const title = "protocolos-pcdt-mcp: os PCDTs do Ministério da Saúde para agentes locais";
const description =
  "Servidor MCP open source que consulta os PCDTs vigentes do Ministério da Saúde/Conitec e resume a conduta para um contexto clínico, com LLM local e citação literal conferida. Um projeto IA.med.";
---

<Layout title={title} description={description}>
  <main>
    <Hero />
    <Disclaimer />
    <Problema />
    <ComoFunciona />
    <Tools />
    <ComoRodar />
  </main>
  <Footer />
</Layout>

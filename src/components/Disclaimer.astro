---
const itens = [
  "Não é fonte oficial do Ministério da Saúde nem da Conitec.",
  "Não substitui o julgamento clínico nem a leitura do protocolo completo.",
  "O resumo é gerado por LLM e pode conter erro. Por isso vem sempre com a citação literal do trecho de origem e o link para o PDF oficial, que devem ser conferidos.",
  "PCDTs são revisados periodicamente. O projeto tenta marcar versões substituídas, mas confirme a vigência na fonte.",
];
---

<section id="aviso" class="border-b border-neutral-900 bg-amber-500/[0.04]">
  <div class="mx-auto max-w-4xl px-6 py-10">
    <div class="rounded-2xl border border-amber-500/25 bg-ink-800 p-6">
      <div class="flex items-center gap-2.5">
        <svg class="h-5 w-5 flex-shrink-0 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z" />
        </svg>
        <h2 class="text-sm font-semibold uppercase tracking-wider text-amber-300">
          Antes de usar, leia
        </h2>
      </div>
      <ul class="mt-4 grid gap-3 sm:grid-cols-2">
        {
          itens.map((t) => (
            <li class="flex gap-2.5 text-sm leading-relaxed text-neutral-300">
              <span class="mt-2 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-amber-400" aria-hidden="true" />
              <span>{t}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
